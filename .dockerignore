# The image build needs go.mod, go.sum, the Go sources, and manifest.yaml (it
# is go:embed'ed). Everything else stays out of the build context so the
# context is small and a change to a fixture or a doc cannot change the image.
.git
.github
.gitignore
.dockerignore
CODEOWNERS
LICENSE
*.md
scripts
testdata
*_test.go
grant.example.json
config.example.yaml
